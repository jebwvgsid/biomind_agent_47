+            'operation': 'prepare' if access == 'mutate' else 'read',
+            'resource_uses': [{'resource_ref': 'plan.workspace', 'access': access, 'role': ROLE}],
+            'outputs': [], 'dependencies': [], 'success_criteria': ['real evidence required'],
