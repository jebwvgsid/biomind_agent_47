+def session_binding(path, root):
+    """Verify the existing session alias against the explicit canonical root."""
+    p = Path(path)
+    require(p.is_absolute() and not any(c in str(p) for c in '\n\r\x00'), 'ABSOLUTE_PATH_REQUIRED')
+    absolute(p.parent, directory=True)
+    root = absolute(root, directory=True)
+    alias = p.lstat()
+    require(alias.st_uid == os.getuid(), 'PATH_OWNER_MISMATCH')
+    if not p.is_symlink():
+        absolute(p, directory=True)
+    require(p.resolve(strict=True) == root, 'SESSION_ROOT_MISMATCH')
+    target = root.stat()
+    return {'path': p, 'root': root,
+            'identity': (alias.st_dev, alias.st_ino, alias.st_mode,
+                         os.readlink(p) if p.is_symlink() else None,
+                         target.st_dev, target.st_ino)}
+
