{
  "name": "biomind-remote-workbench-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BioMind 远程工作台：完全离线的交互原型",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "node scripts/build.mjs --check",
    "build": "node scripts/build.mjs",
    "export": "node scripts/build.mjs && node scripts/export-preview.mjs",
    "test:browser:prepare": "node scripts/build.mjs && node scripts/browser-fixture.mjs",
    "test": "node scripts/build.mjs && node --test tests/service.test.mjs",
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "devDependencies": { "typescript": "5.9.3" }
}
