{
  "name": "biomind-pi-runtime",
  "version": "1.0.0-dev.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "postinstall": "node compat/apply-pi-observer.mjs",
    "check:compat": "node compat/apply-pi-observer.mjs --check",
    "build": "node --max-old-space-size=1024 ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "node --max-old-space-size=1024 ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-test-isolation=none --test-concurrency=1 dist/tests/*.test.js",
    "start": "node dist/host.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
